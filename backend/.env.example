ENVIRONMENT=development
DATABASE_URL=sqlite:///./mplads_sentinel.db
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development previews may use another local port. This regex is disabled when ENVIRONMENT is not development.
DEVELOPMENT_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
AUTO_SEED=true
REDIS_URL=redis://localhost:6379/0
MAX_REQUEST_BYTES=1048576
# Production requires ENVIRONMENT=production, a new SECRET_KEY, and AUTO_SEED=false.
