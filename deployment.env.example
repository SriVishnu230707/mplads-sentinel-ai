# Use image digests approved by your organisation's vulnerability-scanning process.
POSTGRES_IMAGE=postgres:17-alpine@sha256:replace-with-reviewed-digest
REDIS_IMAGE=redis:7-alpine@sha256:replace-with-reviewed-digest
MINIO_IMAGE=minio/minio:RELEASE.replace-with-reviewed-release@sha256:replace-with-reviewed-digest

# Generate long, unique secrets. URL-encode REDIS_PASSWORD when placing it in REDIS_URL.
POSTGRES_PASSWORD=replace-with-a-unique-long-password
DATABASE_URL=postgresql+psycopg://sentinel:url-encoded-postgres-password@postgres:5432/mplads_sentinel
REDIS_PASSWORD=replace-with-a-unique-long-password
REDIS_URL=redis://:url-encoded-redis-password@redis:6379/0
MINIO_ROOT_USER=replace-with-a-non-default-admin-user
MINIO_ROOT_PASSWORD=replace-with-a-unique-long-password
SENTINEL_SECRET_KEY=replace-with-at-least-32-random-bytes
SENTINEL_FRONTEND_ORIGIN=https://sentinel.example.gov.in
